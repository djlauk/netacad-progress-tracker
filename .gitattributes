# Normalise text files to LF in the repository and keep LF in the working tree,
# also on Windows with core.autocrlf=true.
* text=auto eol=lf

# Source, config and docs: always text, always LF.
*.ts         text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.json       text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.ico  binary

# Windows batch files need CRLF.
*.bat        text eol=crlf
